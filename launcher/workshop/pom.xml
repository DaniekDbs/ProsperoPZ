<?xml version="1.0" encoding="UTF-8"?>
<!-- Resolves the Steam Workshop downloader's libraries (JavaSteam and its
     runtime dependencies) into a folder: mvn -q -f launcher/workshop/pom.xml
     dependency:copy-dependencies -DoutputDirectory=DIR -DincludeScope=runtime -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.prosperopz</groupId>
  <artifactId>workshop-libs</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <dependencies>
    <dependency>
      <groupId>in.dragonbra</groupId>
      <artifactId>javasteam-depotdownloader</artifactId>
      <version>1.8.0</version>
    </dependency>
  </dependencies>
</project>
