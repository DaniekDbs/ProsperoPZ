<?xml version="1.0" encoding="UTF-8"?>
<!-- Resolves the Steam Workshop downloader's libraries (JavaSteam and its
     runtime dependencies) into a folder: mvn -q -f launcher/workshop/pom.xml
     dependency:copy-dependencies -DoutputDirectory=DIR -DincludeScope=runtime -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.prosperopz</groupId>
  <artifactId>workshop-libs</artifactId>
  <version>1</version>
  <packaging>pom</packaging>
  <dependencies>
    <dependency>
      <groupId>in.dragonbra</groupId>
      <artifactId>javasteam-depotdownloader</artifactId>
      <version>1.8.0</version>
    </dependency>
    <!-- JavaSteam uses these at runtime without declaring them: BouncyCastle
         (manifest file names), zstd-jni (Zstandard chunks; its jar carries the
         Windows x64 native library) and XZ (LZMA chunks). -->
    <dependency>
      <groupId>com.github.luben</groupId>
      <artifactId>zstd-jni</artifactId>
      <version>1.5.6-6</version>
    </dependency>
    <dependency>
      <groupId>org.tukaani</groupId>
      <artifactId>xz</artifactId>
      <version>1.10</version>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>1.79</version>
    </dependency>
  </dependencies>
</project>
